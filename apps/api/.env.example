# Template only. Copy to .env (gitignored). Never commit real credentials.
# Provide a local-only disposable database password, not a production secret.
PLANTOPS_POSTGRES_DEV_PASSWORD=
DATABASE_URL=
# OIDC stays disabled unless provider credentials AND callback origin exist.
# For Vite local Google login: http://127.0.0.1:5184 (through its proxy)
OIDC_CALLBACK_ORIGIN=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_TENANT_ID=
SESSION_TRUSTED_ORIGINS=
